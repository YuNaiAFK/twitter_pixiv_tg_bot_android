# Secrets and credentials - never commit these.
.env
# `cookies/*` rather than `cookies/`, so the directory itself is not excluded. Git cannot
# re-include a file inside an excluded DIRECTORY, so `cookies/` together with
# `!cookies/.gitkeep` silently kept ignoring the placeholder - verified with
# `git check-ignore -v`, which still reported the `cookies/` rule. Excluding the contents
# leaves the negation working, so a fresh clone still gets the directory.
cookies/*
!cookies/.gitkeep
*.session
authorized.json
parse_cache.json
gallery-dl.conf

# Runtime state.
.bot.lock
restart.log
restart.log.1
data/
.cache/
.downloads/
.gallery-dl-cache/
__pycache__/
*.pyc

# The self-hosted Bot API server's own storage. Large, and rebuilt automatically.
telegram-bot-api/

# Local virtualenvs, if one is ever created on a desktop for testing.
.venv/
venv/

# Scratch files used to pass a commit message to `git commit -F`.
#
# These kept reappearing in the tree: each commit wrote one, `git add -A` staged it, and the
# next commit removed it again. A pattern catches every name instead of one at a time, which is
# what happened when only `_msg.txt` was listed and `_cm.txt` walked straight through.
_*.txt

# The control panel's own runtime files.
panel.pid
panel.log
